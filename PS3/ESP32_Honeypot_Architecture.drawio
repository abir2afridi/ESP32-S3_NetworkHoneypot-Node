<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="Architecture" id="arch1"><mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="System Architecture of ESP32-S3 Network Honeypot Node" style="text;html=1;align=center;fontSize=20;fontStyle=1;fontColor=#15532E;" vertex="1" parent="1"><mxGeometry x="150" y="-10" width="520" height="40" as="geometry"/></mxCell><mxCell id="attacker" value="Attacker / Bot  (laptop, Kali)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="300" y="12" width="120" height="96" as="geometry"/></mxCell><mxCell id="esp32" value="ESP32-S3 Honeypot Node" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="285" y="165" width="150" height="149" as="geometry"/></mxCell><mxCell id="cpu" value="Rule-based classifier" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="305" y="415" width="110" height="109" as="geometry"/></mxCell><mxCell id="cloud" value="Wi-Fi uplink (HTTP)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="300" y="606" width="120" height="88" as="geometry"/></mxCell><mxCell id="db" value="Cloud database and backend" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="310" y="770" width="100" height="99" as="geometry"/></mxCell><mxCell id="dash" value="Security dashboard (web / mobile)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="300" y="922" width="120" height="96" as="geometry"/></mxCell><mxCell id="oled" value="0.96&quot; OLED  (status)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="35" y="114" width="110" height="71" as="geometry"/></mxCell><mxCell id="sd" value="microSD  (logging)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="35" y="258" width="110" height="84" as="geometry"/></mxCell><mxCell id="lipo" value="Battery (LiPo + TP4056 + switch)" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/png,;verticalLabelPosition=bottom;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#14243A;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="120" height="72" as="geometry"/></mxCell><mxCell id="me0" value="Attacker scans the network and probes the fake IoT services (Telnet / HTTP / SSH) and Wi-Fi" style="endArrow=block;html=1;rounded=0;strokeColor=#2B2B2B;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="attacker" target="esp32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me1" value="Runs soft-AP, emulates services, sniffs 802.11 frames in monitor mode" style="endArrow=block;html=1;rounded=0;strokeColor=#2B2B2B;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="esp32" target="cpu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me2" value="Classifies each event: deauth flood, port scan, brute-force, beacon flood" style="endArrow=block;html=1;rounded=0;strokeColor=#2B2B2B;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cpu" target="cloud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me3" value="When online, alerts and event summaries are sent to the backend over Wi-Fi" style="endArrow=block;html=1;rounded=0;strokeColor=#2B2B2B;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cloud" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="me4" value="Logs are stored; heavier ML classification can run server-side" style="endArrow=block;html=1;rounded=0;strokeColor=#2B2B2B;strokeWidth=2;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="db" target="dash"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be0" value="status" style="endArrow=block;html=1;rounded=0;strokeColor=#7B2FD6;strokeWidth=2;fontSize=10;fontColor=#7B2FD6;" edge="1" parent="1" source="esp32" target="oled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be1" value="logs" style="endArrow=block;html=1;rounded=0;strokeColor=#7B2FD6;strokeWidth=2;fontSize=10;fontColor=#7B2FD6;" edge="1" parent="1" source="esp32" target="sd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="be2" value="power" style="endArrow=block;html=1;rounded=0;strokeColor=#7B2FD6;strokeWidth=2;fontSize=10;fontColor=#7B2FD6;" edge="1" parent="1" source="esp32" target="lipo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>